/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "G’s Mac používa Automatizáciu na presúvanie súborov, presun položiek do Koša, otváranie vyžiadaných príkazov a na ovládanie prehrávania vo vašich mediálnych aplikáciách.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "G’s Mac používa zvuk každej aplikácie na nastavenie jej hlasitosti v mixéri a na pridanie zvuku Macu do nahrávok obrazovky, ktoré spustíte. Nič neopustí váš Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "G’s Mac používa Bluetooth len na načítanie stavu batérie pripojeného príslušenstva. Nič neopustí váš Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "G’s Mac nahráva váš mikrofón len vtedy, keď ho zapnete pre nahrávanie obrazovky. Zvuk ostáva na vašom Macu, pokiaľ sa nerozhodnete vytvoriť dočasný odkaz.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "G’s Mac zobrazuje vašu kameru len v okne náhľadu, ktoré otvoríte, aby ste pred hovorom videli, ako vyzeráte. Nič sa nenahráva a nič neopustí váš Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "G’s Mac kontroluje lokálne metadáta v priečinku Stiahnuté, aby preveril, usporiadal alebo presunul do Koša len potvrdené súbory z WhatsAppu, ktoré vyberiete. Čistenie tiež hľadá zabudnuté snímky obrazovky, ak ich sem ukladáte.";

